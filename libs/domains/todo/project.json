{
  "name": "domain_todo",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/domains/todo/src",
  "targets": {
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --package domain_todo",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --package domain_todo",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --package domain_todo",
        "cwd": "{workspaceRoot}"
      }
    },
    "ts-gate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo test --package domain_todo export_bindings",
          "git diff --exit-code -- libs/domains/todo/types"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": []
}
