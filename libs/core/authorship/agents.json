{
  "$comment": "Single source of truth for human-vs-machine attribution. Read by tools/authorship/*.ts (git hooks, CI check) and by the Rust classifiers (taskgraph invoker detection, insights commit classification). Order of `agents` matters for env detection: the first agent with any marker set wins (omp also exports CLAUDECODE, so it precedes claude-code). See docs/ci-insights.md#attribution.",
  "trailer": "Assisted-by",
  "enforcedSince": "2026-09-27",
  "genericEnv": ["AI_AGENT", "AGENT"],
  "genericAgentId": "unknown-agent",
  "agents": [
    {
      "id": "omp",
      "name": "omp",
      "env": ["OMPCODE"],
      "identities": [],
      "coauthorEmails": []
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "env": ["CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"],
      "identities": ["claude-maintenance[bot]", "claude[bot]"],
      "coauthorEmails": ["noreply@anthropic.com"]
    },
    {
      "id": "codex",
