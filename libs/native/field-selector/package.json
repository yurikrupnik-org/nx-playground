{
  "name": "@native/field-selector",
  "version": "0.0.1",
  "description": "Node addon (N-API) over the field-selector Rust crate: runtime-schema field projection with role-based access control.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "index.d.ts", "*.node"],
  "napi": {
    "binaryName": "field-selector",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "CARGO=cargo napi build --platform --no-const-enum --profile napi",
    "build:debug": "CARGO=cargo napi build --platform --no-const-enum",
    "test": "vitest run",
    "lint": "biome check --write ."
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "vitest": "^4.1.10"
  }
}
