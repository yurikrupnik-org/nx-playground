# Editor configuration, see http://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# `kcl fmt` reads indent_size from here; without this section it re-indents
# every .k file to the 2-space default above instead of KCL's canonical 4.
[*.k]
indent_size = 4
