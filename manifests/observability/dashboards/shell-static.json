            "uid": "insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT scan_id FROM shell_scans_v WHERE scanned_at >= $__timeFrom() AND scanned_at < $__timeTo() AND ('__all__' IN ($origin) OR origin IN ($origin)) ORDER BY scanned_at DESC LIMIT 1)\nSELECT s.source_id, s.kind, s.path, s.task, s.lines, s.branches, s.findings,\n       (SELECT count(*) FROM shell_findings_v f\n         WHERE f.scan_id = s.scan_id AND f.source_id = s.source_id AND f.level = 'error') AS errors,\n       s.owner, s.owner_kind\nFROM shell_sources_v s JOIN latest USING (scan_id)\nWHERE s.findings > 0 AND ('__all__' IN ($kind) OR s.kind IN ($kind))\nORDER BY errors DESC, s.findings DESC, s.lines DESC\nLIMIT 50"
        }
