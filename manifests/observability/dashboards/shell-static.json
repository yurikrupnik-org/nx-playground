    {
      "id": 12,
      "type": "timeseries",
      "title": "Top 8 codes over time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH scans AS (\n    SELECT s.scan_id, s.scanned_at FROM shell_scans_v s WHERE s.scanned_at >= $__timeFrom() AND s.scanned_at < $__timeTo() AND ('__all__' IN ($origin) OR s.origin IN ($origin))\n), top AS (\n    SELECT f.code FROM shell_findings_v f JOIN scans USING (scan_id)\n    WHERE ('__all__' IN ($kind) OR f.kind IN ($kind))\n    GROUP BY f.code ORDER BY count(*) DESC LIMIT 8\n)\nSELECT scans.scanned_at AS time, 'SC' || f.code AS metric, count(*)::float8 AS findings\nFROM shell_findings_v f\nJOIN scans USING (scan_id)\nJOIN top USING (code)\nWHERE ('__all__' IN ($kind) OR f.kind IN ($kind))\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
