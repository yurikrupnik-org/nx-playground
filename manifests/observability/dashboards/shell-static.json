    {
      "id": 11,
      "type": "table",
      "title": "Top codes",
      "description": "Click a code for its shellcheck wiki page.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT scan_id FROM shell_scans_v WHERE scanned_at >= $__timeFrom() AND scanned_at < $__timeTo() AND ('__all__' IN ($origin) OR origin IN ($origin)) ORDER BY scanned_at DESC LIMIT 1)\nSELECT 'SC' || f.code AS code, f.level, count(*) AS findings,\n       count(DISTINCT f.source_id) AS sources,\n       min(f.message) AS example\nFROM shell_findings_v f JOIN latest USING (scan_id)\nWHERE ('__all__' IN ($kind) OR f.kind IN ($kind))\nGROUP BY f.code, f.level\nORDER BY findings DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "code"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "shellcheck wiki",
                    "url": "https://www.shellcheck.net/wiki/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "example"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              },
              {
                "id": "custom.wrapText",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
