    {
      "id": 8,
      "type": "timeseries",
      "title": "Task duration p50 per day (top 10 by total time)",
      "description": "Wall time of succeeded + failed executions (up_to_date / cancelled excluded). Narrow with the Task variable.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH top AS (\nSELECT task FROM task_executions_v WHERE outcome IN ('succeeded', 'failed') AND started_at >= $__timeFrom() AND started_at < $__timeTo() AND ('__all__' IN ($source) OR source IN ($source)) AND ('__all__' IN ($invoker) OR invoker_kind IN ($invoker)) AND ('__all__' IN ($task) OR task IN ($task))\nGROUP BY task ORDER BY sum(duration_ms) DESC LIMIT 10)\nSELECT date_trunc('day', e.started_at) AS time, e.task AS metric,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY e.duration_ms) / 1000.0 AS duration\nFROM task_executions_v e JOIN top USING (task)\nWHERE e.outcome IN ('succeeded', 'failed') AND e.started_at >= $__timeFrom() AND e.started_at < $__timeTo() AND ('__all__' IN ($source) OR e.source IN ($source)) AND ('__all__' IN ($invoker) OR e.invoker_kind IN ($invoker)) AND ('__all__' IN ($task) OR e.task IN ($task))\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ],
