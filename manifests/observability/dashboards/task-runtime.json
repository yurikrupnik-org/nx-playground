    {
      "id": 11,
      "type": "table",
      "title": "Failure rate by task",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
