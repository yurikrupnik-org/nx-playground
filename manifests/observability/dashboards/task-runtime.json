          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT task,\n       count(*) AS flaky_shas,\n       max(last_seen) AS last_seen,\n       array_to_string((array_agg(left(sha, 10) ORDER BY last_seen DESC))[1:5], ', ') AS recent_shas\nFROM (\n    SELECT task, sha, max(started_at) AS last_seen\n    FROM task_executions_v\n    WHERE sha IS NOT NULL AND started_at >= $__timeFrom() AND started_at < $__timeTo() AND ('__all__' IN ($source) OR source IN ($source)) AND ('__all__' IN ($invoker) OR invoker_kind IN ($invoker)) AND ('__all__' IN ($task) OR task IN ($task))\n    GROUP BY task, sha\n    HAVING bool_or(outcome = 'succeeded') AND bool_or(outcome = 'failed')\n) f\nGROUP BY task\nORDER BY flaky_shas DESC, last_seen DESC"
        }
      ],
