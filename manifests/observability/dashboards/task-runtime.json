      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT task,\n       count(*) FILTER (WHERE outcome IN ('succeeded', 'failed')) AS executions,\n       count(*) FILTER (WHERE outcome = 'failed') AS failed,\n       (count(*) FILTER (WHERE outcome = 'failed'))::float8 / nullif(count(*) FILTER (WHERE outcome IN ('succeeded', 'failed')), 0) AS failure_rate,\n       max(started_at) FILTER (WHERE outcome = 'failed') AS last_failure\nFROM task_executions_v\nWHERE started_at >= $__timeFrom() AND started_at < $__timeTo() AND ('__all__' IN ($source) OR source IN ($source)) AND ('__all__' IN ($invoker) OR invoker_kind IN ($invoker)) AND ('__all__' IN ($task) OR task IN ($task))\nGROUP BY task\nHAVING count(*) FILTER (WHERE outcome = 'failed') > 0\nORDER BY failure_rate DESC, failed DESC"
        }
      ],
      "fieldConfig": {
