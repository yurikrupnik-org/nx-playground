    {
      "id": 8,
      "type": "timeseries",
      "title": "Commits per week by kind · attribution",
      "description": "Same buckets as kind_scorecard; legacy human commits without a trailer stay 'unknown (pre-attribution)'.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', authored_at) AS time,\n       CASE\n         WHEN author_kind = 'bot' THEN 'bot'\n         WHEN author_kind = 'agent' THEN 'agent'\n         WHEN coalesce(cardinality(assistants), 0) > 0 THEN 'human+agent'\n         WHEN attribution = 'legacy' THEN 'unknown (pre-attribution)'\n         ELSE 'human'\n     END || ' · ' || attribution AS metric,\n       count(*)::float8 AS commits\nFROM commits_v\nWHERE authored_at >= $__timeFrom() AND authored_at < $__timeTo()\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "lineInterpolation": "linear",
            "barAlignment": 0,
