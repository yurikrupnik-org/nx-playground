            "uid": "insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE kind WHEN 'unknown' THEN 'unknown (pre-attribution)' ELSE kind END AS bucket,\n       contributors, commits, additions, deletions, outcome_score,\n       first_pass_rate, change_failure_rate, fixup_rate, lead_time_h, task_failure_rate\nFROM kind_scorecard($__timeFrom(), $__timeTo())\nORDER BY array_position(ARRAY['human', 'human+agent', 'agent', 'bot', 'unknown'], kind), kind"
