      "title": "Kind comparison (kind_scorecard)",
      "description": "human = human author, no assistants, enforced attribution; human+agent = human author with Assisted-by; agent = agent author; bot = bots; unknown (pre-attribution) = human author, no trailer, legacy history.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
