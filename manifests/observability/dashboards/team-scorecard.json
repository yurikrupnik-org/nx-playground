            "uid": "insights"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', authored_at) AS time,\n       avg((author_kind = 'agent')::int)::float8 AS \"agent-authored\",\n       avg((author_kind = 'agent' OR coalesce(cardinality(assistants), 0) > 0)::int)::float8 AS \"agent-involved (authored or assisted)\",\n       avg((attribution = 'legacy')::int)::float8 AS \"legacy (attribution unknown)\"\nFROM commits_v\nWHERE authored_at >= $__timeFrom() AND authored_at < $__timeTo()\nGROUP BY 1\nORDER BY 1"
        }
