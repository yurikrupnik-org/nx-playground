          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT run_id) AS runs FROM ci_runs_v WHERE created_at >= $__timeFrom() AND created_at < $__timeTo() AND ('__all__' IN ($workflow) OR workflow IN ($workflow))"
