    {
      "id": 11,
      "type": "table",
      "title": "Per workflow: duration and queue percentiles",
      "description": "All completed attempts. Duration = started_at → completed_at; queue = created_at → started_at.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT workflow,\n       count(*) AS runs,\n       avg((conclusion = 'success')::int) FILTER (WHERE status = 'completed' AND conclusion NOT IN ('cancelled', 'skipped', 'neutral'))::float8 AS success_rate,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_s) AS p50_duration,\n       percentile_cont(0.9) WITHIN GROUP (ORDER BY duration_s) AS p90_duration,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY queue_s) AS p50_queue,\n       percentile_cont(0.9) WITHIN GROUP (ORDER BY queue_s) AS p90_queue\nFROM ci_runs_v\nWHERE status = 'completed' AND created_at >= $__timeFrom() AND created_at < $__timeTo() AND ('__all__' IN ($workflow) OR workflow IN ($workflow))\nGROUP BY workflow\nORDER BY p90_duration DESC NULLS LAST"
        }
      ],
