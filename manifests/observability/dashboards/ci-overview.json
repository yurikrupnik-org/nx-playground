    {
      "id": 4,
      "type": "stat",
      "title": "Re-run rate",
      "description": "Share of runs with more than one attempt.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
