          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at) AS time,\n       workflow || ' · ' || coalesce(conclusion, status) AS metric,\n       count(*)::float8 AS runs\nFROM ci_runs_v\nWHERE is_latest AND created_at >= $__timeFrom() AND created_at < $__timeTo() AND ('__all__' IN ($workflow) OR workflow IN ($workflow))\nGROUP BY 1, 2\nORDER BY 1, 2"
