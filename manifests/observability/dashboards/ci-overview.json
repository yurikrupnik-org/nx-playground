      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg((conclusion = 'success')::int)::float8 AS success_rate\nFROM ci_runs_v WHERE is_latest AND status = 'completed' AND conclusion NOT IN ('cancelled', 'skipped', 'neutral') AND created_at >= $__timeFrom() AND created_at < $__timeTo() AND ('__all__' IN ($workflow) OR workflow IN ($workflow))"
