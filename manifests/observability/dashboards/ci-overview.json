      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg((attempts > 1)::int)::float8 AS rerun_rate\nFROM (SELECT run_id, max(attempt) AS attempts FROM ci_runs_v WHERE created_at >= $__timeFrom() AND created_at < $__timeTo() AND ('__all__' IN ($workflow) OR workflow IN ($workflow)) GROUP BY run_id) r"
