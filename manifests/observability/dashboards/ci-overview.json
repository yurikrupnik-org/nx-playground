    {
      "id": 2,
      "type": "stat",
      "title": "Success rate",
      "description": "Latest attempt of each completed run; cancelled/skipped/neutral excluded.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
