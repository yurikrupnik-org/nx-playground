{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "inputs": ["production", "^production"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/node_modules/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.{test,spec}.{ts,tsx}",
      "!{projectRoot}/vitest.setup.ts"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci-optimized.yml"]
  },
  "nxCloudId": "6928516e8756394e71566e68",
  "plugins": [
    "@monodon/rust",
    {
      "plugin": "@nx-tools/nx-container",
      "options": {
        "defaultEngine": "docker",
        "defaultRegistry": "docker.io"
      }
    },
    "./tools/nx/plugin.ts"
  ],
  "analytics": true
}
