{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/ci.yml"]
  },
  "nxCloudId": "6928516e8756394e71566e68",
  "plugins": [
    "@monodon/rust",
    {
      "plugin": "@nx-tools/nx-container",
      "options": {
        "defaultEngine": "docker",
        "defaultRegistry": "docker.io"
      }
    },
    {
      "plugin": "./tools/nx-zerg",
      "options": {
        "appsDir": "apps/zerg",
        "imagePrefix": "zerg-",
        "cratePrefix": "zerg_",
        "rustDockerfile": "manifests/dockers/rust.Dockerfile",
        "staticDockerfile": "manifests/dockers/Dockerfile",
        "registryEnv": "REGISTRY",
        "tiltRegistry": "yurikrupnik"
      }
    }
  ]
}
