{
  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(bun nx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gemini:*)",
      "Bash(coderabbit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.envrc)",
      "Read(./**/secrets.env)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./.aws/**)",
      "Read(./**/.aws/**)",
      "Read(./config/credentials.json)",
      "Read(./**/credentials.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*_rsa)",
      "Read(./**/*_ed25519)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)"
    ],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.js\""
          }
        ]
      }
    ]
  }
}
