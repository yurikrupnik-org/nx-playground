{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "target": "ESNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@ui/web-auth": ["../../../libs/ui/web-auth/src/index.ts"]
    }
  },
  "include": ["src", "vitest.setup.ts", "vite.config.ts"]
}
