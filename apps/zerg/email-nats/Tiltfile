# Hardcoded Tiltfile for zerg-email-nats (Rust).
# Fast local dev: builds the dev image (manifests/dockers/rust.dev.Dockerfile) with
# deps pre-compiled, then live_update syncs source into the running container and
# recompiles ONLY changed crates in-place — no image rebuild, no dep recompile.
load('ext://restart_process', 'docker_build_with_restart')

#docker_build_with_restart(
docker_build(
    'yurikrupnik/zerg-email-nats',
    context='../../..',
    dockerfile='../../../manifests/dockers/rust.Dockerfile',
    #dockerfile='../../../manifests/dockers/rust.dev.Dockerfile',
    build_args={'APP_NAME': 'zerg_email_nats'},
    target='rust',
    #entrypoint='/usr/local/bin/app',
    only=[
        'Cargo.toml',
        'Cargo.lock',
        'apps/',
        'libs/',
        'manifests/dockers/rust.Dockerfile',
    ],
    ignore=[
        'target/',
        '**/*.md',
        '**/.git/',
        '**/k8s/',
        '**/Tiltfile',
        'apps/**/node_modules/',
        # Frontend build outputs never belong in a Rust image context. dist is no
        # longer globally ignored (zerg-web needs its own dist), so exclude it here
        # or a web rebuild would bust this image's cache.
        '**/dist/',
        # Exclude every app's src, then re-include only this app's. Editing another
        # app never rebuilds this image; a new app needs no edit here (its src is
        # auto-excluded by the glob and re-included in its own Tiltfile). Sibling
        # Cargo.toml files stay in-context so the workspace resolves (each app has
        # an explicit [[bin]], so no sibling src is needed to build this one).
        'apps/*/*/src',
        '!apps/zerg/email-nats/src',
    ],
    live_update=[
        # A dependency change (lockfile) needs a fresh cook -> full image rebuild.
      #  fall_back_on(['../../../Cargo.lock', '../../../Cargo.toml']),
     #   sync('../../../apps', '/app/apps'),
    #    sync('../../../libs', '/app/libs'),
      #  run(
       #     'cargo build --locked -p zerg_email_nats --target aarch64-unknown-linux-musl',
       #     trigger=['../../../apps/', '../../../libs/'],
       # ),
    ],
)
#k8s_yaml(local('kcl run k8s -D env=dev -D image=yurikrupnik/zerg-email-nats -D namespace=zerg', quiet=True))
#k8s_resource('zerg-email-nats', labels=['backend'], resource_deps=['zerg-shared-config'])
k8s_yaml(kustomize('k8s/kustomize/overlays/dev'))
