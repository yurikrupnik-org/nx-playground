{
  "name": "zerg_api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/zerg/api/src",
  "targets": {
    "openapi-gate": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "cargo test --package zerg_api export_openapi",
          "git diff --exit-code -- docs/openapi/tasks.v1.json"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": []
}
