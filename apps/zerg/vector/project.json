{
  "name": "zerg_vector",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/zerg/vector/src",
  "targets": {
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --package zerg_vector",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "production": {
          "command": "cargo build --package zerg_vector --release"
        }
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --package zerg_vector",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --package zerg_vector",
        "cwd": "{workspaceRoot}"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --package zerg_vector",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "production": {
          "command": "cargo run --package zerg_vector --release"
        }
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "file": "manifests/dockers/rust.Dockerfile",
        "context": ".",
        "build-args": [
          "APP_NAME=zerg_vector"
        ],
        "tags": [
          "$REGISTRY/zerg-vector:latest"
        ],
        "push": false
      },
      "configurations": {
        "ci": {
          "push": true,
          "cache-from": [
            "type=registry,ref=$BUILDCACHE/zerg-vector"
          ],
          "cache-to": [
            "type=registry,ref=$BUILDCACHE/zerg-vector,mode=max,image-manifest=true,oci-mediatypes=true"
          ],
          "metadata": {
            "images": [
              "$REGISTRY/zerg-vector"
            ],
            "tags": [
              "type=sha",
              "type=ref,event=branch",
              "type=ref,event=pr",
              "type=raw,value=$APP_VERSION,enable=$ENABLE_VERSION"
            ]
          }
        }
      }
    },
    "scan": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "container"
      ],
      "options": {
        "command": "trivy image --cache-backend memory $REGISTRY/zerg-vector:latest --severity CRITICAL,HIGH --exit-code 0",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "ci": {
          "command": "trivy image --cache-backend memory $REGISTRY/zerg-vector:sha-$(echo $SHORT_SHA | cut -c1-7) --severity CRITICAL,HIGH --format sarif --output trivy-zerg-vector.sarif"
        }
      }
    }
  },
  "metadata": {
    "tilt": {
      "portForwards": "50051:50051",
      "resourceDeps": [
        "zerg-shared-config"
      ]
    }
  },
  "tags": []
}
