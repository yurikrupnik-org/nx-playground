# Hardcoded Tiltfile for zerg-tasks (Rust).
# Fast local dev: builds the dev image (manifests/dockers/rust.dev.Dockerfile) with
# deps pre-compiled, then live_update syncs source into the running container and
# recompiles ONLY changed crates in-place — no image rebuild, no dep recompile.
load('ext://restart_process', 'docker_build_with_restart')

docker_build_with_restart(
    'yurikrupnik/zerg-tasks',
    context='../../..',
    dockerfile='../../../manifests/dockers/rust.dev.Dockerfile',
    build_args={'APP_NAME': 'zerg_tasks'},
    target='dev',
    entrypoint='/usr/local/bin/app',
    only=[
        'Cargo.toml',
        'Cargo.lock',
        'apps/',
        'libs/',
        'manifests/dockers/rust.dev.Dockerfile',
    ],
    ignore=[
        'target/',
        '**/*.md',
        '**/.git/',
        '**/k8s/',
        '**/Tiltfile',
        'apps/**/node_modules/',
    ],
    live_update=[
        # A dependency change (lockfile) needs a fresh cook -> full image rebuild.
        fall_back_on(['../../../Cargo.lock', '../../../Cargo.toml']),
        sync('../../../apps', '/app/apps'),
        sync('../../../libs', '/app/libs'),
        run(
            'cargo build --locked -p zerg_tasks --target x86_64-unknown-linux-musl',
            trigger=['../../../apps/', '../../../libs/'],
        ),
    ],
)
#k8s_yaml(local('kcl run k8s -D env=dev -D image=yurikrupnik/zerg-tasks -D namespace=zerg', quiet=True))
k8s_yaml(kustomize('k8s/kustomize/overlays/dev'))
k8s_resource('zerg-tasks', port_forwards='50051:50051', labels=['backend'], resource_deps=['zerg-shared-config'])
