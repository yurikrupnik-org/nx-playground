---
// Shared shell: theme + nav. Both variants render the exact same todo DOM
// (class names from libs/ui/todo-theme), so any visual diff is a bug.
import '../../../../../libs/ui/todo-theme/todo.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const links = [
  ['/', 'Compare'],
  ['/solid', 'Solid island'],
  ['/htmx', 'HTML + htmx'],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-nav">
      {links.map(([href, label]) => (
        <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <slot />
  </body>
</html>

<style>
  .site-nav {
    display: flex;
    gap: 1rem;
    justify-content: center;
    padding: 1rem;
    font-size: 0.9rem;
  }
  .site-nav a {
    color: inherit;
    text-decoration: none;
    opacity: 0.7;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    opacity: 1;
    text-decoration: underline;
  }
</style>
