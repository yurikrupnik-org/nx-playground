    "typecheck": "tsc --noEmit",
    "lint": "biome check --write ."
  },
  "license": "MIT",
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/solid-js": "^7.0.2",
    "@domain/todo": "workspace:*",
    "@native/field-selector": "workspace:*",
    "astro": "^7.2.8",
    "htmx.org": "^2.0.10",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
