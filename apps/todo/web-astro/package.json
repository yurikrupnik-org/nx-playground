  "description": "Astro SSR host for the todo vertical: same UI twice \u2014 a Solid island vs pure HTML + htmx fragments (both talk to todo-api).",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "astro preview",
