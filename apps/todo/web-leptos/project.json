{
  "name": "todo-web-leptos",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/todo/web-leptos/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "trunk serve",
        "cwd": "{workspaceRoot}/apps/todo/web-leptos"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "trunk build --release",
        "cwd": "{workspaceRoot}/apps/todo/web-leptos"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "trunk serve --release",
        "cwd": "{workspaceRoot}/apps/todo/web-leptos"
      }
    }
  },
  "tags": []
}
